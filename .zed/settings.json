{
	"format_on_save": "on",
	"tab_size": 2,
	"hard_tabs": true,
	"prettier": {
		"allowed": false
	},
	"languages": {
		"JSON": {
			"formatter": { "language_server": { "name": "biome" } }
		},
		"JSONC": {
			"formatter": { "language_server": { "name": "biome" } }
		},
		"HTML": {
			"formatter": { "language_server": { "name": "biome" } }
		},
		"CSS": {
			"language_servers": ["tailwindcss-intellisense-css", "!vscode-css-language-server", "..."],
			"formatter": { "language_server": { "name": "biome" } }
		},
		"JavaScript": {
			"formatter": { "language_server": { "name": "biome" } },
			"code_actions_on_format": {
				"source.fixAll.biome": true,
				"source.organizeImports.biome": true
			}
		},
		"TypeScript": {
			"formatter": { "language_server": { "name": "biome" } },
			"code_actions_on_format": {
				"source.fixAll.biome": true,
				"source.organizeImports.biome": true
			}
		},
		"Svelte": {
			"language_servers": ["svelte-language-server", "biome", "tailwindcss-language-server", "..."],
			"formatter": { "language_server": { "name": "biome" } },
			"code_actions_on_format": {
				"source.fixAll.biome": true,
				"source.organizeImports.biome": true
			}
		}
	},
	"lsp": {
		"biome": {
			"settings": {
				"require_config_file": true
			}
		},
		"markdownlint": {
			"settings": {
				"MD010": {
					"code_blocks": false
				},
				"MD013": false
			}
		},
		"tailwindcss-language-server": {
			"settings": {
				"includeLanguages": {
					"svelte": "html"
				},
				"classFunctions": ["clsx", "tw", "cn", "twMerge", "cva", "tv"],
				"experimental": {
					"classRegex": [
						"class=\"([^\"]*)\"",
						"class='([^']*)'",
						"class:\\s*([^\\s{]+)",
						"\\{\\s*class:\\s*\"([^\"]*)\"",
						"\\{\\s*class:\\s*'([^']*)'"
					]
				}
			}
		}
	}
}
