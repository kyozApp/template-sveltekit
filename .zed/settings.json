{
	"languages": {
		"JSON": {
			"tab_size": 2,
			"hard_tabs": true,
			"prettier": { "allowed": false },
			"formatter": { "language_server": { "name": "biome" } }
		},
		"JSONC": {
			"tab_size": 2,
			"hard_tabs": true,
			"prettier": { "allowed": false },
			"formatter": { "language_server": { "name": "biome" } }
		},
		"HTML": {
			"tab_size": 2,
			"hard_tabs": true,
			"prettier": { "allowed": false },
			"formatter": { "language_server": { "name": "biome" } }
		},
		"CSS": {
			"tab_size": 2,
			"hard_tabs": true,
			"prettier": { "allowed": false },
			"language_servers": [
				"tailwindcss-intellisense-css",
				"!vscode-css-language-server",
				"..."
			],
			"formatter": { "language_server": { "name": "biome" } }
		},
		"JavaScript": {
			"tab_size": 2,
			"hard_tabs": true,
			"prettier": { "allowed": false },
			"formatter": { "language_server": { "name": "biome" } },
			"code_actions_on_format": {
				"source.fixAll.biome": true,
				"source.organizeImports.biome": true
			}
		},
		"TypeScript": {
			"tab_size": 2,
			"hard_tabs": true,
			"prettier": { "allowed": false },
			"formatter": { "language_server": { "name": "biome" } },
			"code_actions_on_format": {
				"source.fixAll.biome": true,
				"source.organizeImports.biome": true
			}
		},
		// "Svelte": {
		// 	"tab_size": 2,
		// 	"hard_tabs": true,
		// 	"formatter": { "language_server": { "name": "biome" } },
		// 	"code_actions_on_format": {
		// 		"source.fixAll.biome": true
		// 	}
		// }
		// "Svelte": {
		// 	"tab_size": 2,
		// 	"hard_tabs": true,
		// 	"prettier": {
		// 		"allowed": true,
		// 		"plugins": ["prettier-plugin-svelte", "prettier-plugin-tailwindcss"]
		// 	},
		// 	"formatter": "prettier"
		// }
		"Svelte": {
			"tab_size": 2,
			"hard_tabs": true,
			"prettier": {
				"allowed": true,
				"plugins": ["prettier-plugin-svelte", "prettier-plugin-tailwindcss"]
			},
			"formatter": [
				"prettier",
				{ "code_action": "source.fixAll.biome" },
				{ "code_action": "source.organizeImports.biome" },
				{ "language_server": { "name": "biome" } }
			]
		}
	},
	"lsp": {
		"tailwindcss-language-server": {
			"settings": {
				"includeLanguages": { "svelte": "html" },
				"experimental": {
					"classRegex": [
						"class=\"([^\"]*)\"",
						"class='([^']*)'",
						"class:\\s*([^\\s{]+)",
						"\\{\\s*class:\\s*\"([^\"]*)\"",
						"\\{\\s*class:\\s*'([^']*)'"
					]
				}
			}
		}
	}
}
