{
	"name": "template-sveltekit",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"build": "vite build && vite build --config vite.worker.config.ts",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"dev": "vite dev",
		"fix": "biome check --write .",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"lint": "biome lint .",
		"lint:fix": "biome lint --write .",
		"prepare": "svelte-kit sync || echo ''",
		"preview": "vite preview",
		"seed": "tsx --env-file=.env src/prisma/seed.ts",
		"start": "node --env-file=.env build/index.js",
		"worker:dev": "tsx watch --env-file=.env src/worker.ts",
		"worker:start": "node --env-file=.env build/worker.js"
	},
	"dependencies": {
		"@fontsource-variable/inter": "^5.3.0",
		"@prisma/orm-postgres": "8.0.0-rc.17",
		"argon2": "^0.45.1",
		"cron": "^4.4.0",
		"dotenv": "^18.0.7",
		"mode-watcher": "^1.1.0",
		"nanoid": "^6.0.2",
		"valibot": "^1.5.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@inlang/paraglide-js": "^2.27.0",
		"@lucide/svelte": "^1.55.0",
		"@prisma/cli-engine": "^0.7.0",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.0.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.6.5",
		"prisma": "8.0.0-rc.22",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"vite": "^8.3.4"
	},
	"packageManager": "pnpm@12.11.2",
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "24.21.0",
			"onFail": "download"
		}
	}
}
